# No API secrets belong here. Session cookies are httpOnly and set by the server.
# User passwords are hashed in data/store.json — never commit that file.
#
# Telegram (server-only). Never prefix these with VITE_ and never put them in client code.
# Local: put them in the project-root .env file (gitignored). The server loads TELEGRAM_* into process.env.
# Production: Netlify Site settings → Environment variables (same names, no VITE_ prefix).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional webhook secret (send the same value as secret_token when calling setWebhook):
# TELEGRAM_WEBHOOK_SECRET=
# Optional. Required to call /api/telegram/test in production:
# TELEGRAM_TEST_KEY=
